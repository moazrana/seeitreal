# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed (spec §7.1). The app refuses to boot if any
# required variable below is missing — see src/config/env.validation.ts.

# --- App ---
NODE_ENV=development
PORT=4001
# Public base URL of this API (used to build diner-facing QR/AR links).
# Must match PORT above, or generated upload/AR links point at the wrong place.
API_BASE_URL=http://localhost:4001
# Comma-separated explicit CORS allow-list — never use "*" for authenticated endpoints.
CORS_ALLOWED_ORIGINS=http://localhost:4173

# --- Database (MySQL via Prisma) ---
# Use a least-privilege DB user in production (no DROP/GRANT) — spec §7.7.
# Port 3307 (not MySQL's default 3306) — matches docker-compose.yml.
DATABASE_URL=mysql://ar_menu:ar_menu_dev_password@localhost:3307/ar_menu_dev

# --- Auth / JWT ---
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage (object storage for uploads / 3D models, e.g. Cloudflare R2) ---
# "local" writes to disk (LOCAL_STORAGE_DIR) and serves via GET /api/uploads —
# fine for dev/self-hosted, per spec §7.5's "non-executable directory
# outside the web root" option. Use "s3" in production (R2-compatible).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- 3D generation (Tripo) ---
# Server-side only. Must never be exposed to the frontend (spec §11.4).
# Get a key at https://platform.tripo3d.ai/api-keys
TRIPO_API_KEY=
# Override only if Tripo's API host changes; defaults to the v3 host in code.
TRIPO_BASE_URL=
# Shared secret embedded in the callback_url given to Tripo — verifies
# inbound webhook calls. Generate with: openssl rand -hex 32
TRIPO_WEBHOOK_SECRET=
# Required by Tripo's submit call (rejects the request without one). See
# TripoClientService for the allowed-values list returned by a bad value;
# defaults to 'v3.1-20260211' in code if left unset here.
TRIPO_MODEL_VERSION=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics IP hashing ---
# Random pepper used to hash diner IPs before storing (spec §5, §7.7).
# Generate with: openssl rand -hex 32
IP_HASH_SALT=
