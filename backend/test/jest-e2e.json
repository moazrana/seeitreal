{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "property-graph[\\\\/]dist[\\\\/]index\\.mjs$": "<rootDir>/../jest-property-graph-transform.cjs"
  },
  "transformIgnorePatterns": ["/node_modules/(?!@ar-menu/|property-graph/)"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
